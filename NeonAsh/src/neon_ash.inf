  print "She listens to the whole story without interrupting. Then she takes out something wrapped in oilcloth: a box of tarnished copper mesh. ~Military Faraday cage. Pre-war. Nothing gets in or out. Our healer can draw the thing from your port into this box. It will sleep there, forever, and you will live.~";
  print "^^";
  print "~But HM will never stop hunting the box. So you must leave the city with us. Ride the salt. Never come back.~ She smiles. ~There are worse lives.~";
  if (((flags->61 ~= 0))) { print "^^"; print "~You came home,~ she adds, and squeezes your hand. ~I knew you would. The road always brings us back.~"; }
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "~Deal. I'll ride with you.~"; }
  k = 1; if (k || 1) { Opt(1, k); print "~Let me think.~"; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_riders_deal;
    1: flags->44 = 1; return N_saltgate;
  }
  jump Redraw;
];
