  k = 1; if (k || 1) { Opt(0, k); print "Broadcast everything. Wake the city up."; }
  k = (((v_echo >= 3))); if (k || 1) { Opt(1, k); print "[ECHO TRUST 3] ~ECHO -- don't scatter. Come with me into the net. Both of us.~"; }
  k = (((v_mind >= 7))); if (k || 1) { Opt(2, k); print "[MIND 7] Rewrite the broadcast mid-stream: kill Lullaby, return stolen memories, nothing else."; }
  k = GetKey();
