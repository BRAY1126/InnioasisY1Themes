[ N_f_corp_trap redo k;
  .Redraw;
  Header();
  print "Thorne's voice comes through a speaker. ~Thank you for bringing our property home. I did promise you a job. I'm afraid I lied about which one.~";
  print "^^";
  print "~The extraction will be total. MNEMOSYNE, and everything it touched. Which is everything. You'll wake up as a junior analyst on floor 12 with a very nice apartment and no idea who you used to be. Honestly? It's an upgrade.~";
  print "^^";
  print "The spider machine begins to descend. ECHO is screaming in your head.";
  nvis = 0;
  k = (((v_echo >= 3))); if (k || 1) { Opt(0, k); print "[ECHO TRUST 3] ECHO: ~Let me out -- into their network. Trust me.~"; }
  k = (((v_body >= 7))); if (k || 1) { Opt(1, k); print "[BODY 7] Tear the restraints out of the chair."; }
  k = (((v_reflex >= 7))); if (k || 1) { Opt(2, k); print "[REFLEX 7] Slip one wrist free -- you dislocated your thumb on purpose -- and go."; }
  k = 1; if (k || 1) { Opt(3, k); print "Close your eyes. Let it happen."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
