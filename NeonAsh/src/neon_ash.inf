  print "^^";
  print "~Whatever you choose,~ ECHO says, ~I'm with you. I don't have much choice about that.~ A pause. ~But I'd want to be anyway.~";
  if (((flags->11 == 0) && (flags->13 == 0) && (flags->14 == 0) && (flags->12 == 0))) { print "^^"; print "You haven't made a deal with anyone. It's just you and the voice in your head. Maybe that's enough. Maybe it isn't."; }
  nvis = 0;
  k = (((flags->11 ~= 0))); if (k || 0) { Opt(0, k); print "Go to Thorne. Let Halvorsen-Mori take it out."; }
  k = (((flags->13 ~= 0))); if (k || 0) { Opt(1, k); print "Go to Mother Lux. Lie down on the altar."; }
  k = (((flags->14 ~= 0))); if (k || 0) { Opt(2, k); print "Go to Null. Climb the mast."; }
  k = (((flags->12 ~= 0))); if (k || 0) { Opt(3, k); print "Go to the Salt Riders. Midnight at the gate."; }
  if (~~(((flags->11 == 0)) || ((flags->13 == 0)))) { k = (((v_nerve >= 7))); if (k || 1) { Opt(4, k); print "[NERVE 7] Sell MNEMOSYNE to HM and the Saints. Same place, same time."; } }
  k = 1; if (k || 1) { Opt(5, k); print "No factions. Just you and ECHO."; }
