!% -v5
!% -~S
Constant Story "NEON ASH";
Constant Headline "^A text adventure in Port Halcyon, 2091.^";
Release 1;
Constant NFLAGS = 69;
Constant NENDINGS = 34;
Constant MAX_BURN = 12;
Global v_body;
Global v_burn;
Global v_echo;
Global v_heat;
Global v_humanity;
Global v_juno;
Global v_mind;
Global v_money;
Global v_nerve;
Global v_pts;
Global v_reflex;
Global v_rep_corp;
Global v_rep_nomad;
Global v_rep_saints;
Global v_rep_static;
Global v_tech;
Global nvis;
Array flags -> NFLAGS;
Array namebuf -> 30;
Global namelen;
Array vis --> 12;
Array ena -> 12;
Array keybuf -> 4;

[ Main n;
  @erase_window -1;
  Title();
  for (n = 0 : n < NFLAGS : n++) flags->n = 0;
  n = N_start;
  while (n ~= 0) n = n(0);
  @quit;
];

[ Title k i;
  print "^^   N E O N   A S H^";
  print "   ---------------^";
  print "   A text adventure in Port Halcyon, 2091.^^";
  print "   ", NENDINGS, " endings. Stats unlock options. Every choice matters.^^";
  print "   Keys: 1-9 choose.  S save, R restore, T stats, Q quit.^^";
  print "   1. New game^   2. Restore a saved game^^> ";
  for (::) {
    @read_char 1 -> k;
    if (k == '1') break;
    if (k == '2') { @restore -> i; print "^Could not restore.^> "; }
  }
  @erase_window -1;
  print "IDENTIFY YOURSELF^^What do they call you on the street?^> ";
  namebuf->0 = 24; namebuf->1 = 0;
  @aread namebuf 0 -> i;
  namelen = namebuf->1;
  if (namelen == 0) {
    namebuf->2 = 'v'; namebuf->3 = '0'; namebuf->4 = 'i'; namebuf->5 = 'd'; namelen = 4;
  }
];

[ PName i c;
  for (i = 0 : i < namelen : i++) {
    c = namebuf->(i + 2);
    if (i == 0 && c >= 'a' && c <= 'z') c = c - 32;
    print (char) c;
  }
];

[ PMoney n;
  if (n >= 1000) { print n / 1000, ","; n = n % 1000;
    if (n < 100) print "0"; if (n < 10) print "0"; }
  print n;
];

[ Clamp;
  if (v_body < 0) v_body = 0; if (v_body > 10) v_body = 10;
  if (v_burn < 0) v_burn = 0; if (v_burn > 99) v_burn = 99;
  if (v_heat < 0) v_heat = 0; if (v_heat > 99) v_heat = 99;
  if (v_humanity < 0) v_humanity = 0; if (v_humanity > 10) v_humanity = 10;
  if (v_mind < 0) v_mind = 0; if (v_mind > 10) v_mind = 10;
  if (v_money < 0) v_money = 0; if (v_money > 32000) v_money = 32000;
  if (v_nerve < 0) v_nerve = 0; if (v_nerve > 10) v_nerve = 10;
  if (v_reflex < 0) v_reflex = 0; if (v_reflex > 10) v_reflex = 10;
  if (v_tech < 0) v_tech = 0; if (v_tech > 10) v_tech = 10;
];

[ Header;
  @erase_window -1;
  print "[", (PName) 0, "] B", v_body, " R", v_reflex, " T", v_tech, " M", v_mind,
        " N", v_nerve, " | "; PMoney(v_money); print " cr^";
  if (flags->3) print "BURN ", v_burn, "/", MAX_BURN, "  HEAT ", v_heat, "  HUMANITY ", v_humanity, "/10^";
  print "--------------------------------^^";
];

[ Opt idx en;
  nvis++; vis-->nvis = idx; ena->nvis = en;
  print "^", nvis, ". ";
  if (~~en) print "(locked) ";
];

[ Stats;
  print "^^BODY ", v_body, "  REFLEX ", v_reflex, "  TECH ", v_tech, "  MIND ", v_mind,
        "  NERVE ", v_nerve, "^MONEY "; PMoney(v_money);
  print " cr  HEAT ", v_heat, "  HUMANITY ", v_humanity, "/10  BURN ", v_burn, "/", MAX_BURN, "^";
];

! Returns the chosen choice index, or -1 if a saved game was just restored.
[ GetKey k r;
  print "^^> ";
  for (::) {
    @read_char 1 -> k;
    if (k >= '1' && k <= '9') {
      k = k - '0';
      if (k <= nvis) {
        if (ena->k) { print k, "^"; return vis-->k; }
        print "^[Locked: you don't have what it takes. Yet.]^> ";
      }
    }
    if (k == 's' or 'S') {
      @save -> r;
      if (r == 2) return -1;
      if (r) print "^[Saved.]^> "; else print "^[Save failed.]^> ";
    }
    if (k == 'r' or 'R') { @restore -> r; print "^[Restore failed.]^> "; }
    if (k == 't' or 'T') { Stats(); print "> "; }
    if (k == 'q' or 'Q') { print "^The rain keeps falling without you.^"; @quit; }
  }
];

[ EndScreen title num k;
  print "^^*** ENDING ", num, " of ", NENDINGS, ": ", (string) title, " ***^^";
  print "Press any key to play again.^";
  @read_char 1 -> k;
  @restart;
];

[ N_start redo k;
  .Redraw;
  Header();
  print "PORT HALCYON, 2091.";
  print "^^";
  print "A city built on a drowned city. Forty million people, every one of them wired into the Lattice through the neural port behind their ear. Rain that never quite stops. Light that never quite reaches the ground.";
  print "^^";
  print "The megacorp Halvorsen-Mori owns the towers, the water, the police, and most of the air. Everyone else owns whatever they can hold onto.";
  print "^^";
  print "You've been holding on for a long time, ";
  PName();
  print ". Where did you come from?";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "GUTTER-BORN. Raised in the flooded markets of Rustwater. You know every alley, every debt, every lie."; }
  k = 1; if (k || 1) { Opt(1, k); print "SALT RIDER. Grew up on the salt flats beyond the wall, in a convoy clan. Engines, sky, and family."; }
  k = 1; if (k || 1) { Opt(2, k); print "GLASS-BLOOD. A Halvorsen-Mori employee in a tower office. Until last night, when you read something you shouldn't have."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_o_street;
    1:  return N_o_salt;
    2:  return N_o_glass;
  }
  jump Redraw;
];
[ N_o_street redo k;
  if (redo == 0) { flags->62 = 1; v_body = 2; v_reflex = 3; v_tech = 2; v_mind = 2; v_nerve = 3; v_pts = 6; v_money = 300; v_humanity = 10; Clamp(); return N_alloc; }
  return 0;
];
[ N_o_salt redo k;
  if (redo == 0) { flags->61 = 1; v_body = 3; v_reflex = 2; v_tech = 3; v_mind = 2; v_nerve = 2; v_pts = 6; v_money = 500; v_humanity = 10; Clamp(); return N_alloc; }
  return 0;
];
[ N_o_glass redo k;
  if (redo == 0) { flags->21 = 1; v_body = 2; v_reflex = 2; v_tech = 2; v_mind = 3; v_nerve = 3; v_pts = 6; v_money = 1500; v_humanity = 10; flags->35 = 1; Clamp(); return N_alloc; }
  return 0;
];
[ N_alloc redo k;
  .Redraw;
  Header();
  print "WHO ARE YOU, REALLY?";
  print "^^";
  print "Spend your points. Every attribute unlocks different options throughout the city. Nothing is wasted; everything closes some doors and opens others.";
  print "^^";
  print "-- BODY ";
  print v_body;
  print ": strength, toughness, intimidation.^-- REFLEX ";
  print v_reflex;
  print ": speed, guns, driving, getting out alive.^-- TECH ";
  print v_tech;
  print ": hacking, machines, hardware.^-- MIND ";
  print v_mind;
  print ": intelligence, noticing things, reading people.^-- NERVE ";
  print v_nerve;
  print ": cool, charm, lies, keeping your head.";
  print "^^";
  print "Points remaining: ";
  print v_pts;
  print "  (max 7 per attribute)";
  nvis = 0;
  k = (((v_pts >= 1) && (v_body < 7))); if (k || 1) { Opt(0, k); print "+1 BODY"; }
  k = (((v_pts >= 1) && (v_reflex < 7))); if (k || 1) { Opt(1, k); print "+1 REFLEX"; }
  k = (((v_pts >= 1) && (v_tech < 7))); if (k || 1) { Opt(2, k); print "+1 TECH"; }
  k = (((v_pts >= 1) && (v_mind < 7))); if (k || 1) { Opt(3, k); print "+1 MIND"; }
  k = (((v_pts >= 1) && (v_nerve < 7))); if (k || 1) { Opt(4, k); print "+1 NERVE"; }
  k = 1; if (k || 1) { Opt(5, k); print "Start over."; }
  k = (((v_pts == 0))); if (k || 1) { Opt(6, k); print "Lock it in. Let's go."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0: v_body = v_body + 1; v_pts = v_pts - 1; Clamp(); return N_alloc;
    1: v_reflex = v_reflex + 1; v_pts = v_pts - 1; Clamp(); return N_alloc;
    2: v_tech = v_tech + 1; v_pts = v_pts - 1; Clamp(); return N_alloc;
    3: v_mind = v_mind + 1; v_pts = v_pts - 1; Clamp(); return N_alloc;
    4: v_nerve = v_nerve + 1; v_pts = v_pts - 1; Clamp(); return N_alloc;
    5:  return N_alloc_reset;
    6:  return N_alloc_done;
  }
  jump Redraw;
];
[ N_alloc_reset redo k;
  if (redo == 0) { if (((flags->62 ~= 0))) return N_o_street; if (((flags->61 ~= 0))) return N_o_salt; return N_o_glass; }
  return 0;
];
[ N_alloc_done redo k;
  if (redo == 0) { if (((flags->62 ~= 0))) return N_p_street; if (((flags->61 ~= 0))) return N_p_salt; return N_p_glass; }
  return 0;
];
[ N_p_street redo k;
  .Redraw;
  Header();
  print "RUSTWATER MARKETS. 23:40.";
  print "^^";
  print "The noodle stall under the monorail is the only warm place for six blocks. You're halfway through a bowl of synth-pork when the rain on the awning changes rhythm. Footsteps. Three sets.";
  print "^^";
  print "Deacon Ruiz of the Chrome Saints sits down beside you like an old friend. His halo -- a ring of polished steel bolted into his skull -- drips rainwater onto the counter. Two acolytes stand behind him, very still.";
  print "^^";
  print "~Two thousand creds, ";
  PName();
  print ". Mother Lux was patient. Mother Lux is done being patient.~";
  print "^^";
  print "You have ";
  PMoney(v_money);
  print ". You do not have two thousand.";
  nvis = 0;
  k = (((v_nerve >= 5))); if (k || 1) { Opt(0, k); print "[NERVE 5] ~I've got a big job lined up. Give me a week and I'll pay double.~"; }
  k = (((v_reflex >= 5))); if (k || 1) { Opt(1, k); print "[REFLEX 5] Flip the boiling noodle pot into Ruiz's face and run."; }
  k = (((v_body >= 5))); if (k || 1) { Opt(2, k); print "[BODY 5] Grab the nearest acolyte and break his arm on the counter. Make a point."; }
  k = 1; if (k || 1) { Opt(3, k); print "Push all your money across the counter and beg."; }
  k = 1; if (k || 1) { Opt(4, k); print "Go for the pistol in Ruiz's waistband."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_p_street_talk;
    1:  return N_p_street_run;
    2:  return N_p_street_fight;
    3:  return N_p_street_beg;
    4:  return N_e_wrong_alley;
  }
  jump Redraw;
];
[ N_p_street_talk redo k;
  if (redo == 0) { v_rep_saints = v_rep_saints + 1; flags->56 = 1; Clamp(); }
  .Redraw;
  Header();
  print "You don't blink. You tell him about the job -- the one you don't have yet -- with enough detail that you almost believe it yourself.";
  print "^^";
  print "Ruiz studies you for a long moment, then laughs, a sound like gravel in a blender. ~Double. In a week. You hear that? The rat's got ambition.~";
  print "^^";
  print "He taps his halo. ~Mother Lux likes ambition. One week, ";
  PName();
  print ". After that, we baptize you in the canal.~";
  print "^^";
  print "They leave. The noodle vendor exhales for the first time in two minutes.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Finish your noodles. Your phone is buzzing."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_street_call;
  }
  jump Redraw;
];
[ N_p_street_run redo k;
  if (redo == 0) { v_rep_saints = v_rep_saints - 1; v_heat = v_heat + 1; Clamp(); }
  .Redraw;
  Header();
  print "The pot goes up, the broth goes everywhere, and Ruiz goes backwards off his stool screaming. You're already moving -- under the counter, through the curtain, out the back where the fish crates are stacked.";
  print "^^";
  print "Rustwater is a maze and you were raised in it. Ninety seconds later you're three levels up a fire escape, listening to the acolytes curse below.";
  print "^^";
  print "You've bought time. You've also made an enemy who will remember your face.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Catch your breath. Your phone is buzzing."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_street_call;
  }
  jump Redraw;
];
[ N_p_street_fight redo k;
  if (redo == 0) { v_rep_saints = v_rep_saints + 1; v_heat = v_heat + 1; v_humanity = v_humanity - 1; Clamp(); }
  .Redraw;
  Header();
  print "The acolyte's arm makes a sound you will hear again in your sleep. He folds. The second acolyte reaches for a blade and you put him into the noodle vat.";
  print "^^";
  print "Ruiz doesn't move. He just smiles, slowly, chrome teeth catching neon.";
  print "^^";
  print "~Mother Lux will want to meet you. Not today. But she will.~ He drops a coin on the counter for the noodles and walks out into the rain.";
  print "^^";
  print "You're not sure if that was a threat or a job offer. In the Undertow it's usually both.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Wipe your hands. Your phone is buzzing."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_street_call;
  }
  jump Redraw;
];
[ N_p_street_beg redo k;
  if (redo == 0) { v_money = 0; flags->56 = 1; v_humanity = v_humanity + 1; Clamp(); }
  .Redraw;
  Header();
  print "You put everything on the counter. Every crumpled bill, every chit. Your pride goes on there too, though it doesn't count toward the total.";
  print "^^";
  print "Ruiz counts it slowly, in front of everyone. Then he pockets it.";
  print "^^";
  print "~Interest,~ he says. ~The debt stands. But Mother Lux values humility. You've got a week.~";
  print "^^";
  print "The noodle vendor slides you a fresh bowl, free. Rustwater looks after its own, in small ways.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Eat. Your phone is buzzing."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_street_call;
  }
  jump Redraw;
];
[ N_street_call redo k;
  .Redraw;
  Header();
  print "A text. No name, just a silver crescent icon you'd know anywhere.";
  print "^^";
  print "VESPER KANE: Heard you need creds. I need hands. Last Light. One hour. Come alone and come sober.";
  print "^^";
  print "Vesper is the best fixer in Rustwater. Vesper does not call people like you. Not unless the job is big -- or the job is bad.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Head to the Last Light."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_vesper;
  }
  jump Redraw;
];
[ N_e_wrong_alley redo k;
  .Redraw;
  Header();
  print "You're fast. Ruiz is chrome.";
  print "^^";
  print "His hand closes around your wrist before your fingers touch the grip. He sighs, almost sadly, like a teacher with a slow student. The acolytes take you out the back.";
  print "^^";
  print "They find you three days later in the canal under the old Shenzhen Bridge, a little steel halo hammered into your forehead -- the Saints' joke about converts.";
  print "^^";
  print "The noodle stall plays your favorite song once, the next night, in your honor. Then the rain washes the chalk outline off the street, and Rustwater forgets you, the way it forgets everyone.";
  EndScreen("WRONG ALLEY", 1);
  return 0;
];
[ N_p_salt redo k;
  .Redraw;
  Header();
  print "THE SALT GATE. 22:15.";
  print "^^";
  print "Three years since you left the Riders. Grandmother Asa kissed your forehead when you went and said what the old ones always say: ~The road remembers.~ You weren't sure, then, if it was a blessing or a warning.";
  print "^^";
  print "Now your battered water-hauler idles in a line of trucks at the wall, under Lumen Security floodlights. Lumen is Halvorsen-Mori's private police. Behind the false panel in your cargo bed: forty doses of anti-rejection meds for a chromedoc in Rustwater called Doc Marrow. Black market. Very illegal. Very needed.";
  print "^^";
  print "A guard in a mirrored visor raps on your window. A scanner drone hums toward your cargo.";
  nvis = 0;
  k = (((v_tech >= 5))); if (k || 1) { Opt(0, k); print "[TECH 5] Pop the dash and spoof the scanner's handshake with your homemade deck."; }
  k = (((v_nerve >= 5))); if (k || 1) { Opt(1, k); print "[NERVE 5] Smile. ~Just a water hauler, officer. Long night for both of us.~"; }
  k = (((v_reflex >= 6))); if (k || 1) { Opt(2, k); print "[REFLEX 6] Floor it through the barrier before the drone reaches the bed."; }
  k = (((v_money >= 200))); if (k || 1) { Opt(3, k); print "[200 cr] Fold 200 cr into your permit and hand it over."; }
  k = 1; if (k || 1) { Opt(4, k); print "Tell them about the hidden compartment. It's not worth dying for."; }
  k = 1; if (k || 1) { Opt(5, k); print "Reach under the seat for the shotgun."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_p_salt_tech;
    1:  return N_p_salt_talk;
    2:  return N_p_salt_run;
    3:  return N_p_salt_bribe;
    4:  return N_p_salt_surrender;
    5:  return N_e_gate;
  }
  jump Redraw;
];
[ N_p_salt_tech redo k;
  if (redo == 0) { flags->2 = 1; }
  .Redraw;
  Header();
  print "Your deck is a brick of salvaged circuit boards held together with salt- crusted tape, and it is beautiful. You find the drone's handshake protocol, feed it a clean manifest, and watch its little light blink green.";
  print "^^";
  print "~Water,~ the guard reads, bored. ~Go.~";
  print "^^";
  print "The wall swallows your truck. Behind you, the salt flats go dark.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Drive into the city."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_p_salt_marrow;
  }
  jump Redraw;
];
[ N_p_salt_talk redo k;
  if (redo == 0) { flags->2 = 1; }
  .Redraw;
  Header();
  print "You talk about the drought, the water prices, how the guard's shift must be murder. You don't look at the cargo bed once. You laugh at his joke, which isn't funny.";
  print "^^";
  print "He waves the drone off. ~Get out of here, salt.~";
  print "^^";
  print "You do, slowly, like an innocent person would.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Drive into the city."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_p_salt_marrow;
  }
  jump Redraw;
];
[ N_p_salt_run redo k;
  if (redo == 0) { flags->2 = 1; v_heat = v_heat + 2; Clamp(); }
  .Redraw;
  Header();
  print "The engine screams. The barrier arm splinters across your windshield. The guard dives, the drone spins, and you are through, fishtailing onto the elevated highway with sirens howling behind you.";
  print "^^";
  print "You lose them in the old freight tunnels -- Riders know every hole in the wall. But Lumen has your plates now.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Drive into the city."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_p_salt_marrow;
  }
  jump Redraw;
];
[ N_p_salt_bribe redo k;
  if (redo == 0) { flags->2 = 1; v_money = v_money - 200; Clamp(); }
  .Redraw;
  Header();
  print "The guard looks at the bills. Looks at you. The money disappears the way money always disappears in Port Halcyon -- quietly, into someone else's pocket.";
  print "^^";
  print "~Welcome to the city,~ he says, and means none of it.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Drive into the city."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_p_salt_marrow;
  }
  jump Redraw;
];
[ N_p_salt_surrender redo k;
  if (redo == 0) { v_money = v_money - 200; v_humanity = v_humanity - 1; Clamp(); }
  .Redraw;
  Header();
  print "You tell them. They pull the panel, take the meds, take your truck, and take two hours of your life in a holding cell. A sergeant gives you a lecture about the law, then sells the meds back to a Rustwater dealer before his shift ends. You know because you watch him do it.";
  print "^^";
  print "They let you go at dawn, on foot, with a fine you'll never pay. At least you're inside the wall.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Walk into the city."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_salt_call;
  }
  jump Redraw;
];
[ N_p_salt_marrow redo k;
  if (redo == 0) { flags->40 = 1; v_humanity = v_humanity + 1; Clamp(); }
  .Redraw;
  Header();
  print "Doc Marrow's clinic is a converted laundromat in Rustwater. Marrow has eight arms -- two original, six surgical -- and opens the crate with all of them at once.";
  print "^^";
  print "~Forty doses. Forty people who don't reject their chrome this month.~ The doc looks up at you with something rare in this city: gratitude. ~I owe you, Rider. Remember that. I will.~";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Rest. Your phone is buzzing."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_salt_call;
  }
  jump Redraw;
];
[ N_salt_call redo k;
  .Redraw;
  Header();
  print "A text from an unknown number. Just a silver crescent.";
  print "^^";
  print "VESPER KANE: You're the Rider who just came through the wall. Impressive. I have work for someone nobody in the city knows yet. Last Light, Rustwater. One hour.";
  print "^^";
  print "You've heard the name. Everyone has. Vesper Kane: the fixer who makes impossible jobs possible, for a percentage.";
  nvis = 0;
  k = 1; if (k || 1) { Opt(0, k); print "Head to the Last Light."; }
  k = GetKey();
  if (k < 0) jump Redraw;
  switch (k) {
    0:  return N_vesper;
  }
  jump Redraw;
];
[ N_e_gate redo k;
  .Redraw;
  Header();
  print "The shotgun is halfway up when the turret on the wall finds you.";
  print "^^";
  print "It doesn't make much noise. Lumen Security buys quiet guns.";
  print "^^";
  print "They tow your truck to an impound lot and auction the parts. The meds go to a dealer. Doc Marrow waits for a delivery that never comes, and forty people in Rustwater reject their chrome that month.";
  print "^^";
